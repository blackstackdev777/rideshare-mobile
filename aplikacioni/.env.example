# Vetëm në server. Vendos vlerën private në .env.local, jo në këtë skedar.
DATABASE_URL=
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Alternatively use these names instead of GITHUB_ID/GITHUB_SECRET/NEXTAUTH_SECRET.
# Both naming schemes are supported; keep NEXTAUTH_URL with either scheme.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
